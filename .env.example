# Login
DASH_USER=admin
# Entweder Klartext …
DASH_PASSWORD=bitte-aendern
# … oder argon2-Hash (empfohlen): nrz_dashboard hash-password '<passwort>'
# DASH_PASSWORD_HASH=$argon2id$v=19$...
# 1 setzen, wenn nrzDashboard hinter HTTPS läuft
COOKIE_SECURE=0

# umbrelOS MCP (Einstellungen → AI agents (MCP))
UMBREL_URL=http://umbrel.local
UMBREL_MCP_TOKEN=umbrelmcp_...

# Speicherort für Ping-Ziele und Sitzungen
DATA_DIR=data

# Server-Adresse
IP=0.0.0.0
PORT=8080

# nrzNews (Board-Widget „Nachrichten“): MCP-Server und API-Token (nrzNews → Einstellungen → Konto)
# NRZNEWS_URL=http://host.docker.internal:8340
# NRZNEWS_TOKEN=nrznews_...
